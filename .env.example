# Django
DJANGO_SETTINGS_MODULE=leadsmanager.settings
SECRET_KEY=your-secret-key-here
DEBUG=False

# Database (Cloud SQL en prod, MySQL local en dev)
DB_NAME=your_db_name
DB_USR=your_db_user
DB_PASS=your_db_password
DB_HOST=127.0.0.1
DB_PORT=3306

# WordPress API (fuente de leads)
WPCUSTOMAPISUBM=https://your-wp-site.com/wp-json/your-endpoint/
WPUSER=your_wp_user
WPPASS=your_wp_password

# Integraciones externas
SRTOK=your_token
APPHOST=https://your-app-url.run.app
PRFTAPIKEY=your_api_key

# Demo mode (True activa el banner y el botón de regenerar datos en /usersfuncs/)
DEMO_MODE=False
